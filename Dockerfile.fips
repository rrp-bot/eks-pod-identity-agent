ARG golang_image
ARG base_image

# The Red Hat Go toolchain supplies system-crypto support. Pin both images to
# approved content in the release environment.
FROM ${golang_image} AS builder
WORKDIR /tmp
RUN mkdir -p /tmp/workspace && chmod 0777 /tmp/workspace
WORKDIR /tmp/workspace
ARG TARGETOS=linux
ARG TARGETARCH=amd64
ENV GO111MODULE=on \
    GOPROXY=direct \
    CGO_ENABLED=1 \
    GOFIPS140=certified \
    GO_BUILD_TAGS=strictfipsruntime,no_openssl \
    GOFLAGS=-buildvcs=false
COPY . .
RUN GOOS=$TARGETOS GOARCH=$TARGETARCH make build

FROM ${base_image}
ARG TARGETARCH=amd64
RUN microdnf install -y ca-certificates openssl-libs \
    && microdnf clean all
ENV GODEBUG=fips140=auto
COPY --from=builder /tmp/workspace/_output/${TARGETARCH}/bin/eks-pod-identity-agent \
    /eks-pod-identity-agent
